{
  "name": "iobroker.sql",
  "description": "Log states into SQL database",
  "version": "4.1.5",
  "author": "bluefox <dogafox@gmail.com>",
  "contributors": [
    "bluefox <dogafox@gmail.com>",
    "Apollon77"
  ],
  "homepage": "https://github.com/ioBroker/ioBroker.sql",
  "repository": {
    "type": "git",
    "url": "https://github.com/ioBroker/ioBroker.sql"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "ioBroker",
    "log data",
    "home automation"
  ],
  "optionalDependencies": {
    "mssql": "^12.7.1",
    "mysql2": "^3.24.4",
    "pg": "^8.23.0",
    "sqlite3": "^6.0.1"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/aggregate": "^1.0.1",
    "@iobroker/plugin-docker": "^1.2.1"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@iobroker/build-tools": "^3.0.3",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.2.2",
    "@types/mssql": "^12.3.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "mocha": "^12.0.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "bugs": {
    "url": "https://github.com/ioBroker/ioBroker.sql/issues"
  },
  "main": "build/main.js",
  "files": [
    "admin/",
    "img/",
    "build/",
    "docker-compose.yaml",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "test:package": "mocha test/testPackageFiles.js --exit",
    "test:integration": "mocha --exit",
    "test": "mocha --exit",
    "lint": "eslint -c eslint.config.mjs && cd src-admin && eslint -c eslint.config.mjs",
    "check:ts": "tsc -p tsconfig.json --noEmit",
    "build": "npm run build:ts && npm run build:admin",
    "build:ts": "tsc -p tsconfig.build.json",
    "prepublishOnly": "npm run build",
    "release": "release-script",
    "release-patch": "release-script patch --yes",
    "release-minor": "release-script minor --yes",
    "release-major": "release-script major --yes",
    "update-packages": "npx npm-check-updates --upgrade && cd src-admin && npx npm-check-updates --upgrade",
    "build:admin": "tsx tasks.ts",
    "npm": "npm i && cd src-admin && npm i -f"
  },
  "license": "MIT"
}
