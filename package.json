{
    "name": "iobroker.sql",
    "description": "Log states into SQL database",
    "version": "3.0.1",
    "author": "bluefox <dogafox@gmail.com>",
    "contributors": [
        "bluefox <dogafox@gmail.com>",
        "Apollon77"
    ],
    "homepage": "https://github.com/ioBroker/ioBroker.sql",
    "repository": {
        "type": "git",
        "url": "https://github.com/ioBroker/ioBroker.sql"
    },
    "engines": {
        "node": ">=22"
    },
    "keywords": [
        "ioBroker",
        "log data",
        "home automation"
    ],
    "optionalDependencies": {
        "mssql": "^12.7.0",
        "mysql2": "^3.23.2",
        "pg": "^8.22.0",
        "sqlite3": "^6.0.1"
    },
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.3",
        "@iobroker/plugin-docker": "^1.0.3",
        "dockerode": "^4.0.9"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.2",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^5.3.0",
        "@types/mssql": "^12.3.0",
        "@types/pg": "^8.20.3",
        "@types/tar-fs": "^2.0.4",
        "mocha": "^11.8.0",
        "typescript": "^6.0.3"
    },
    "bugs": {
        "url": "https://github.com/ioBroker/ioBroker.sql/issues"
    },
    "main": "build/main.js",
    "files": [
        "admin/",
        "img/",
        "build/",
        "docker-compose.yaml",
        "io-package.json",
        "LICENSE"
    ],
    "scripts": {
        "test": "mocha --exit",
        "lint": "eslint -c eslint.config.mjs",
        "check:ts": "tsc -p tsconfig.json --noEmit",
        "build": "tsc -p tsconfig.build.json",
        "prepublishOnly": "npm run build",
        "release": "release-script",
        "release-patch": "release-script patch --yes",
        "release-minor": "release-script minor --yes",
        "release-major": "release-script major --yes",
        "update-packages": "ncu --upgrade"
    },
    "license": "MIT"
}
